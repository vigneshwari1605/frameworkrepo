<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>IBM</groupId>
  <artifactId>AdvanceSelenium</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
  	<maven.compiler.target>1.8</maven.compiler.target>
  	<maven.compiler.source>1.8</maven.compiler.source>
  </properties>
  <profiles>
    <profile>
    <id>RT</id>
    <build>
        <plugins>
            <!-- Maven Surefire Plugin to execute TestNG suites -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version> <!-- Use a stable plugin version -->
                <configuration>
                    <suiteXmlFiles>
                        <!-- Provide the path relative to the project root -->
                        <suiteXmlFile>testng_RT.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
    </profile>
    
    <profile>
    <id>ST</id>
    <build>
        <plugins>
            <!-- Maven Surefire Plugin to execute TestNG suites -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version> <!-- Use a stable plugin version -->
                <configuration>
                    <suiteXmlFiles>
                        <!-- Provide the path relative to the project root -->
                        <suiteXmlFile>testng_ST.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
    </profile>
  </profiles>
  

  <dependencies> 
